PORT=3001
DB_HOST=localhost
DB_USER=
DB_PORT=3306
DB_PASSWORD=
DB_NAME=tesis_db
ELECTRICITY_MAPS_API_KEY=

# Autenticación (login del sistema: admin / visitante)
# JWT_SECRET: cualquier cadena larga y aleatoria (ver README para generarla)
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH: hash bcrypt de la contraseña del admin (ver README para generarlo)
ADMIN_PASSWORD_HASH=
ADMIN_NOMBRE=Administrador
VISITANTE_USERNAME=visitante
# VISITANTE_PASSWORD_HASH: hash bcrypt de la contraseña del visitante (ver README para generarlo)
VISITANTE_PASSWORD_HASH=
VISITANTE_NOMBRE=Visitante
